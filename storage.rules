rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Each signed-in person can read and write only their own post media,
    // and only a photo or video of a sensible size.
    match /posts/{uid}/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && (request.resource.contentType.matches('image/(jpeg|png)')
          || request.resource.contentType.matches('video/(mp4|quicktime)'))
        && request.resource.size <= 100 * 1024 * 1024;
    }
  }
}
